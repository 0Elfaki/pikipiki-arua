DEFAULT_LONGITUDE=30.9073
DEFAULT_CITY="Arua"
DEFAULT_COUNTRY="UG"
DEFAULT_CURRENCY="UGX"

# Mapbox / Google Maps API Keys
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJ5b3VyLXRva2VuIn0.demo
